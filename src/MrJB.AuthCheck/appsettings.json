{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Error",
        "System": "Warning",
        "System.Net.Http": "Error",
        "System.Net.Http.HttpClient": "Error",
        "Polly": "Fatal"
      }
    },
    "Enrich": [
      "FromLogContext"
    ]
  }
}
